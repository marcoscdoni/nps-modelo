### Example environment variables for the NPS app (do NOT commit your real `.env`)
# Copy this file to `.env` and fill with your configuration

# Backend endpoints exposed by this same app
NPS_BACKEND_SURVEY_URL=/api/pesquisa
NPS_BACKEND_TOKEN_VALIDATION_URL=/api/validate-token

# Optional: set a human-readable name used in the payload
NPS_AUTOESCOLA_NAME=

# Local dev token fallback for manual testing (do not use in production)
NPS_DEFAULT_TOKEN=

# Backend configuration (kept secret in production)
NPS_SURVEY_WEBHOOK_URL=
NPS_VALIDATION_WEBHOOK_URL=
NPS_API_KEY=
NPS_API_KEY_HEADER=x-api-key

# Port used by the integrated server (frontend + backend)
PORT=3000
